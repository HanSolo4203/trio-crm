# Same Supabase project as Right Stay Africa. This app uses its own crm_* tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Do not prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_resend_key
DIGEST_EMAIL_TO=you@example.com
DIGEST_SECRET=generate-with-openssl-rand-hex-32
# Dashboard → Settings → API → service_role. Bypasses RLS for the cron digest.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Defaults to Trio CRM <onboarding@resend.dev>, which only delivers
# to the Resend account address until you verify a domain.
DIGEST_EMAIL_FROM=Trio CRM <digest@your-domain.com>
